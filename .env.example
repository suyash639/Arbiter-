# Arbiter Configuration Template
# Copy this file to .env and fill in your values
# Do NOT commit the actual .env file to version control

# --- Data Store Paths ---
BOOK_PATH=./data/client_book.json
MARKET_PATH=./data/market_data.json

# --- LLM Provider Configuration ---
# Options for LLM_PROVIDER: 'gemini', 'valura', 'openai'
# Default when not specified is 'valura' (for assessment gateway) or 'gemini' if GEMINI_API_KEY is present.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# --- Option A: Google Gemini Backend ---
# When LLM_PROVIDER=gemini, Arbiter uses Gemini's OpenAI-compatible endpoint.
# Set your Gemini API Key here (or via GEMINI_API_KEY environment variable):
GEMINI_API_KEY=your_gemini_api_key_here

# --- Option B: OpenAI / Assessment Gateway Backend ---
# For local dev / assessment gateway / custom OpenAI-compatible proxies:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_api_key_here

# --- Service Server Port ---
PORT=8080
